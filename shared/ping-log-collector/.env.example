# Copy to .env (never commit .env).
# Elasticsearch endpoint reachable from inside the container. With a
# kubectl port-forward to your Elasticsearch pod running on the Mac, OrbStack
# reaches it at http://host.docker.internal:9200.
PING_LOGS_ES_URL=https://elasticsearch.example:9200
# Encoded Elasticsearch API key (the "encoded" value), sent as "Authorization: ApiKey <value>".
PING_LOGS_ES_APIKEY=

# Names of the local Docker containers to read (docker_logs matches by name prefix).
PING_PF_CONTAINER=pingfederate
PING_GATEWAY_CONTAINER=pinggateway
# Privilege gateway: its container name (written to the host field) and the
# external Docker volume that holds its /var/log/procyon/cyonproxy.log.
PING_PRIVILEGE_GW_CONTAINER=privilege-gateway
PING_PRIVILEGE_GW_LOG_VOLUME=privilege-gateway-logs
