{
  "info": {
    "name": "CIBA Approval Sequence LAB",
    "description": "API collection for CIBA Approval Sequence LAB: the lab's read surface (talk track, approval-sequence diagram) plus the Mock/Real toggle and its unconfigured refusal. The sequence itself is rendered from data; the lab's mock lane is a labelled simulation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "postman-ciba-approval-sequence-lab"
  },
  "item": [
    {
      "name": "Sanity (mock, labelled)",
      "description": "Health and mode info (mock by default; Real is owner-run).",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().state).to.eql('ready');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/health",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Info (mode is mock by default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().mode).to.eql('mock');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/info",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "info"
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "Story data",
      "description": "The talk track and the approval-sequence diagram the page renders.",
      "item": [
        {
          "name": "Talk track",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().talk.length).to.be.above(0);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/talk-track",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "talk-track"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Approval sequence diagram",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json()).to.have.property('source');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/diagram",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "diagram"
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "Mode toggle",
      "description": "The Mock/Real toggle. Real needs owner-run settings (REAL_CIBA_*); without them it answers 409 with what is missing — that refusal is the negative case here.",
      "item": [
        {
          "name": "Switch to Real without settings (negative, 409 with detail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.expect(pm.response.code).to.eql(409);",
                  "pm.expect(pm.response.json()).to.have.property('detail');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"real\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/mode",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "mode"
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "LAB_BASE",
      "value": "http://localhost:7834"
    }
  ]
}
