    {
      "name": "Mint tokens (both shapes)",
      "description": "Mint a token with string-shaped or array-shaped groups. The mock note says it: HS256 fixture key, signs nothing real.",
      "item": [
        {
          "name": "Mint an array-shaped token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().mock).to.eql(true);",
                  "pm.expect(pm.response.json().claims).to.have.property('isMemberOf');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shape\": \"array\",\n  \"groups\": [\n    \"mcp:read\",\n    \"mcp:write\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/mint",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "mint"
              ]
            },
            "description": ""
          },
          "response": []
        },
