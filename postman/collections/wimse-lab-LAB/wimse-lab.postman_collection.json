    {
      "name": "Mint and hop",
      "description": "Mint a WIT (workloadId must be a clean wimse:// URI), chain a Txn-Token from it (sub is the end user), then validate the hop: the Txn-Token's tth must match the WIT. Both tokens chain via collection variables.",
      "item": [
        {
          "name": "Mint a WIT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mint a WIT\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().token).to.include('.');",
                  "  pm.collectionVariables.set('WIT', pm.response.json().token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workloadId\": \"wimse://corp.example.com/payments/agent\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/mint/wit",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "mint",
                "wit"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Mint a WIT with a traversal path (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mint a WIT with a traversal path (negative)\", function () {",
                  "  pm.expect(pm.response.code).to.eql(400);",
                  "  pm.expect(pm.response.json().error).to.eql('invalid_workload_id');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workloadId\": \"wimse://corp.example.com/../etc\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/mint/wit",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "mint",
                "wit"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Mint a Txn-Token from the WIT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mint a Txn-Token from the WIT\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().token).to.include('.');",
                  "  pm.collectionVariables.set('TXN', pm.response.json().token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"witString\": \"{{WIT}}\",\n  \"sub\": \"alice\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/mint/txn",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "mint",
                "txn"
              ]
            },
            "description": ""
          },
          "response": []
        },
