    {
      "name": "Attack suite",
      "description": " kinds: wrong-aud, swap-txn, swap-wit, expired, untrusted-domain. Each returns valid:false with the failure that caught it.",
      "item": [
        {
          "name": "Attack: swap-txn (present someone else's Txn-Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Attack: swap-txn (present someone else's Txn-Token)\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().valid).to.eql(false);",
                  "  pm.expect(pm.response.json().failures.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"swap-txn\",\n  \"txnString\": \"{{TXN}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/attack",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "attack"
              ]
