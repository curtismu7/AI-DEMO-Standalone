{
  "info": {
    "name": "WIMSE Lab",
    "description": "API collection for WIMSE Lab: mint WIMSE Workload Identity Tokens (wit+jwt, EdDSA) and Transaction Tokens (txn+jwt) chained from a WIT, validate the hop binding (tth), and run the attack suite (wrong aud, swapped Txn-Token, swapped WIT, expired, untrusted domain). Keys are in-process and labelled; the lab has no live mode.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "postman-wimse-lab"
  },
  "item": [
    {
      "name": "Sanity",
      "description": "Health and build info.",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/health",
