    {
      "name": "Token and hops",
      "description": "Mint a federated token at the mock IdP (chained into the calls via the IDP_TOKEN collection variable), decode it, then call the mock MCP server direct and through the gateway. Runs and the netguard log record every hop.",
      "item": [
        {
          "name": "Mint a federated token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mint a federated token\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().token).to.include('.');",
                  "  pm.collectionVariables.set('IDP_TOKEN', pm.response.json().token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appId\": \"payments-agent\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/idp/token",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "idp",
                "token"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Decode the token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Decode the token\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{IDP_TOKEN}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/idp/decode",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "idp",
                "decode"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Decode garbage (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Decode garbage (negative)\", function () {",
                  "  pm.expect(pm.response.code).to.eql(400);",
                  "  pm.expect(pm.response.json().error).to.eql('undecodable');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"garbage\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/idp/decode",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "idp",
                "decode"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "MCP call through the gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"MCP call through the gateway\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().result.tools.length).to.be.above(0);",
                  "});"
