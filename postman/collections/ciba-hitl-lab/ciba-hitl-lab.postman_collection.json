    {
      "name": "The CIBA beat",
      "description": "Write starts the approval (backchannel auth request); its identifier chains into approve, deny and expire. Expire needs a fresh identifier, so it runs last.",
      "item": [
        {
          "name": "Start an approval request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Start an approval request\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().ok).to.eql(true);",
                  "  pm.collectionVariables.set('CIBA_IDENTIFIER', pm.response.json().identifier);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/write",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "write"
