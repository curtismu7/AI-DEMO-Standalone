{
  "info": {
    "name": "CIBA HITL Lab",
    "description": "API collection for CIBA HITL Lab: the human-in-the-loop CIBA story against in-process mocks (mock IAM, mock Authorize policy, mock CIBA, mock gateway, mock MCP/RS). A write starts the approval request, approve/deny resolve the identifier, expire expires it, decode inspects the tokens. Everything is a labelled mock; the lab has no live mode.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "postman-ciba-hitl-lab"
  },
  "item": [
    {
      "name": "Sanity (mock, labelled)",
      "description": "Health, mode info and the scenario catalog (persona, agent, exchanger, downstream).",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().state).to.eql('ready');",
                  "});"
                ]
              }
            }
          ],
          "request": {
