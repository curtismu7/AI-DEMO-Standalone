#!/usr/bin/env bash
# pre-push: refuse to push meta-repo commits whose submodule pins reference
# commits that are not on the submodule's remote ("not our ref" breaks every
# consumer machine). Checks every changed gitlink in the pushed range.
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  [ "$remote_sha" = "0000000000000000000000000000000000000000" ] && remote_sha=$(git hash-object -t tree /dev/null)
  while read -r line; do
    case "$line" in :160000*) ;; *) continue;; esac
    new_sha="$(printf '%s' "$line" | awk '{print $4}')"
    name="$(printf '%s' "$line" | sed 's/^[^\t]*\t//')"
    [ -n "$name" ] || continue
    sub="$(git config -f .gitmodules --get "submodule.$name.url" 2>/dev/null)"
    [ -n "$sub" ] || sub="$(git -C "$name" remote get-url origin 2>/dev/null)"
    [ -n "$sub" ] || continue
    if ! git ls-remote --heads "$sub" 2>/dev/null | grep -q "$new_sha"; then
      echo "BLOCKED: pin for $name at ${new_sha:0:8} is not on $sub — push that submodule first (or re-pin to its pushed head)."
      status=1
    fi
  done < <(git diff-tree -r --no-commit-id "$local_sha" --not "$remote_sha" -- standalone shared 2>/dev/null)
done
exit $status
