# ~/Development/.env: the one settings file for every standalone app.
# Copy this file to ~/Development/.env, fill in the REPLACE_ME values, then run:
#   chmod 600 ~/Development/.env && ./scripts/check-env.sh
#
# Never put admin or worker credentials here. They go in ~/.config/demo-kit/provisioning.json.
# Each app keeps its own port defaults in code, so this file holds no PORT.

# PingOne environment. Required by the apps that sign in.
PINGONE_ENVIRONMENT_ID=REPLACE_ME
PINGONE_REGION=REPLACE_ME        # com, eu, ca or asia

# Optional: read a different settings file for any app.
# STANDALONE_ENV=/path/to/other.env
