# ~/Development/.env: the one settings file for every standalone app (rule 94).
# Copy this file to ~/Development/.env, fill in the REPLACE_ME values, then run:
#   chmod 600 ~/Development/.env && ./scripts/check-env.sh
#
# Never put admin or worker credentials here. They go in ~/.config/demo-kit/provisioning.json.
# Each app keeps its own port defaults in code, so this file holds no PORT.
#
# Rule 19: an app whose Real mode is configured starts in Real mode; Mock is the
# default only when the keys below are absent.

# --- PingOne (SaaS). Required by the apps that sign in. ---
PINGONE_ENVIRONMENT_ID=REPLACE_ME
PINGONE_REGION=REPLACE_ME        # com, eu, ca or asia (na/us alias to com)

# --- PingFederate. Required by the PF live modes. ---
# PF_URL=https://your-pf.example:9031
# PF_AUDIENCE=your-audience
# PF_CA_FILE=/path/to/root-ca.pem   # trust for a private-CA PF certificate

# --- PingOne Privilege (SaaS console). Users point at their own tenant. ---
# PRIVILEGE_CONSOLE_URL=https://console.privilege.pingone.com/   # default: the public console
# PRIVILEGE_SSO_CLIENT_ID=REPLACE_ME
# PRIVILEGE_SSO_CLIENT_SECRET=REPLACE_ME
# PRIVILEGE_SSO_ENV_ID=REPLACE_ME

# --- Privilege Agent Gateway (a SaaS-enrolled gateway; ping-shared does not run one). ---
# PRIVILEGE_GATEWAY_URL=https://your-gateway.example

# Optional: read a different settings file for any app.
# STANDALONE_ENV=/path/to/other.env

# --- Demo shelf (launcher). Written by scripts/bootstrap.sh; read by every app's
# GET /api/shelf for the header "Shelf" button. ---
# SHELF_URL=https://local.ping-devops.com:8443
